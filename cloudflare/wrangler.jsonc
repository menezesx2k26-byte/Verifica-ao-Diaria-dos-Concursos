{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concursos-watch-redundante",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["2,12,32,42 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "WATCH_STATE",
      "id": "SUBSTITUA_PELO_ID_DO_KV"
    }
  ]
  // Depois de habilitar Cloudflare Email Service, acrescente:
  // "send_email": [{ "name": "EMAIL" }]
}
